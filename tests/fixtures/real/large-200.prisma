/// Billing account.
model BillingAccount {
  id        Int      @id @default(autoincrement())
  name String
  isActive Boolean @default(true) @map("is_active")
  startsOn DateTime? @map("starts_on") @db.Date
  code String? @map("code_value")
  payload Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  memberships BillingMembership[]
  billingTags BillingTag[]
  billingItems BillingItem[]
  billingBatchs BillingBatch[]
  billingEvents BillingEvent[]
  outgoingTransfers BillingTransfer[] @relation("BillingTransferFrom")
  incomingTransfers BillingTransfer[] @relation("BillingTransferTo")
  ownedHrPayments HrPayment[]
  ownedLedgerEvents LedgerEvent[]
  ownedShippingTags ShippingTag[]
  ownedShippingEvents ShippingEvent[]

  @@map("billing_accounts")
}

