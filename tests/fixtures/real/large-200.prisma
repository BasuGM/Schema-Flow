  memberId   Int @map("member_id")
  membership ShippingMembership @relation(fields: [accountId, memberId], references: [accountId, memberId])
  description String? @db.Text
  name String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountId, memberId, id])
  @@map("shipping_membership_grants")
}

/// Shipping tag.
model ShippingTag {
  id        Int      @id @default(autoincrement())
  accountId Int @map("account_id")
  account ShippingAccount @relation(fields: [accountId], references: [id])
  documentId Int @map("document_id")
  document ShippingDocument @relation(fields: [documentId], references: [id])
  ownerId   Int?    @map("owner_account_id")
  owner     BillingAccount? @relation(fields: [ownerId], references: [id])
  startsOn DateTime? @map("starts_on") @db.Date
  code String? @map("code_value")
  payload Json?
  quantity Int @default(0)
  amount Decimal @default(0) @db.Decimal(12, 2)
  status    ShippingStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shippingInvoices ShippingInvoice[]
  shippingPayments ShippingPayment[]
  shippingRates ShippingRate[]
  shippingItems ShippingItem[]
  shippingDocuments ShippingDocument[]

  @@index([accountId])
  @@index([documentId])
  @@map("shipping_tags")
}

/// Shipping item.
model ShippingItem {
  id        Int      @id @default(autoincrement())
  documentId Int? @map("document_id")
  document ShippingDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  quantity Int @default(0)
  amount Decimal @default(0) @db.Decimal(12, 2)
  description String? @db.Text
  name String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shippingEvents ShippingEvent[]
  shippingAttachments ShippingAttachment[]
  // implicit many-to-many
  tags ShippingTag[]

  @@index([documentId])
  @@map("shipping_items")
}

/// Shipping batch.
model ShippingBatch {
  id        Int      @id @default(autoincrement())
  accountId Int @map("account_id")
  account ShippingAccount @relation(fields: [accountId], references: [id])
  name String
  isActive Boolean @default(true) @map("is_active")
  startsOn DateTime? @map("starts_on") @db.Date
  code String? @map("code_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shippingEvents ShippingEvent[]

  @@index([accountId])
  @@map("shipping_batchs")
}

/// Shipping event.
model ShippingEvent {
  id        Int      @id @default(autoincrement())
  itemId Int @map("item_id")
  item ShippingItem @relation(fields: [itemId], references: [id])
  batchId Int? @map("batch_id")
  batch ShippingBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  ownerId   Int?    @map("owner_account_id")
  owner     BillingAccount? @relation(fields: [ownerId], references: [id])
  code String? @map("code_value")
  payload Json?
  quantity Int @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shippingLines ShippingLine[]
  shippingPayments ShippingPayment[]
  shippingAttachments ShippingAttachment[]

  @@index([itemId])
  @@index([batchId])
  @@map("shipping_events")
}

/// Shipping invoice.
model ShippingInvoice {
  id        Int      @id @default(autoincrement())
  tagId Int? @map("tag_id")
  tag ShippingTag? @relation(fields: [tagId], references: [id], onDelete: SetNull)
  amount Decimal @default(0) @db.Decimal(12, 2)
  description String? @db.Text
  name String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tagId])
  @@map("shipping_invoices")
}

/// Shipping line.
model ShippingLine {
  id        Int      @id @default(autoincrement())
  profileId Int? @map("profile_id")
  profile ShippingProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  eventId Int @map("event_id")
  event ShippingEvent @relation(fields: [eventId], references: [id])
  isActive Boolean @default(true) @map("is_active")
  startsOn DateTime? @map("starts_on") @db.Date
  code String? @map("code_value")
  status    ShippingStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@index([eventId])
  @@map("shipping_lines")
}

/// Shipping payment.
model ShippingPayment {
  id        Int      @id @default(autoincrement())
  tagId Int @map("tag_id")
  tag ShippingTag @relation(fields: [tagId], references: [id])
  eventId Int @map("event_id")
  event ShippingEvent @relation(fields: [eventId], references: [id])
  ownerId   Int?    @map("owner_account_id")
  owner     MarketingAccount? @relation(fields: [ownerId], references: [id])
  payload Json?
  quantity Int @default(0)
  amount Decimal @default(0) @db.Decimal(12, 2)
  description String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tagId])
  @@index([eventId])
  @@map("shipping_payments")
}

/// Shipping note.
model ShippingNote {
  id        Int      @id @default(autoincrement())
  parentId  Int?    @map("parent_id")
  parent    ShippingNote? @relation("ShippingNoteThread", fields: [parentId], references: [id])
  replies   ShippingNote[] @relation("ShippingNoteThread")
  documentId Int @map("document_id")
  document ShippingDocument @relation(fields: [documentId], references: [id])
  memberId Int? @map("member_id")
  member ShippingMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  description String? @db.Text
  name String
  isActive Boolean @default(true) @map("is_active")
  startsOn DateTime? @map("starts_on") @db.Date
  code String? @map("code_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shippingSettings ShippingSetting[]

  @@index([documentId])
  @@index([memberId])
  @@map("shipping_notes")
}

/// Shipping attachment.
model ShippingAttachment {
  id        Int      @id @default(autoincrement())
  eventId Int @map("event_id")
  event ShippingEvent @relation(fields: [eventId], references: [id])
  itemId Int @map("item_id")
  item ShippingItem @relation(fields: [itemId], references: [id])
  startsOn DateTime? @map("starts_on") @db.Date
  code String? @map("code_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventId])
  @@index([itemId])
  @@map("shipping_attachments")
}

/// Shipping approval.
model ShippingApproval {
  id        Int      @id @default(autoincrement())
  ownerId   Int?    @map("owner_account_id")
  owner     OpsAccount? @relation(fields: [ownerId], references: [id])
  quantity Int @default(0)
  amount Decimal @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shipping_approvals")
}

/// Shipping schedule.
model ShippingSchedule {
  id        Int      @id @default(autoincrement())
  memberId Int @map("member_id")
  member ShippingMember @relation(fields: [memberId], references: [id])
  name String
  isActive Boolean @default(true) @map("is_active")
  status    ShippingStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId])
  @@map("shipping_schedules")
}

/// Shipping rate.
model ShippingRate {
  id        Int      @id @default(autoincrement())
  tagId Int @map("tag_id")
  tag ShippingTag @relation(fields: [tagId], references: [id])
  code String? @map("code_value")
  payload Json?
  quantity Int @default(0)
  amount Decimal @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tagId])
  @@map("shipping_rates")
}

/// Shipping transfer.
model ShippingTransfer {
  id        Int      @id @default(autoincrement())
  fromId    Int @map("from_account_id")
  toId      Int @map("to_account_id")
  from      ShippingAccount @relation("ShippingTransferFrom", fields: [fromId], references: [id])
  to        ShippingAccount @relation("ShippingTransferTo", fields: [toId], references: [id])
  amount Decimal @default(0) @db.Decimal(12, 2)
  description String? @db.Text
  name String
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shipping_transfers")
}

/// Shipping setting.
model ShippingSetting {
  id        Int      @id @default(autoincrement())
  noteId Int @map("note_id")
  note ShippingNote @relation(fields: [noteId], references: [id])
  memberId Int @map("member_id")
  member ShippingMember @relation(fields: [memberId], references: [id])
  isActive Boolean @default(true) @map("is_active")
  startsOn DateTime? @map("starts_on") @db.Date
  code String? @map("code_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([noteId])
  @@index([memberId])
  @@map("shipping_settings")
}
