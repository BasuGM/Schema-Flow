  code String? @map("code_value")
  status    LedgerStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledgerRates LedgerRate[]

  @@index([profileId])
  @@index([batchId])
  @@map("ledger_lines")
}

