  id        Int      @id @default(autoincrement())
  itemId Int? @map("item_id")
  item LedgerItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  ownerId   Int?    @map("owner_account_id")
  owner     BillingAccount? @relation(fields: [ownerId], references: [id])
  code String? @map("code_value")
  payload Json?
  quantity Int @default(0)
  amount Decimal @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledgerPayments LedgerPayment[]
  ledgerAttachments LedgerAttachment[]

  @@index([itemId])
  @@map("ledger_events")
}

/// Ledger invoice.
model LedgerInvoice {
  id        Int      @id @default(autoincrement())
  batchId Int @map("batch_id")
  batch LedgerBatch @relation(fields: [batchId], references: [id])
  accountId Int @map("account_id")
  account LedgerAccount @relation(fields: [accountId], references: [id])
  amount Decimal @default(0) @db.Decimal(12, 2)
  description String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ledgerApprovals LedgerApproval[]

  @@index([batchId])
  @@index([accountId])
  @@map("ledger_invoices")
}

/// Ledger line.
model LedgerLine {
  id        Int      @id @default(autoincrement())
